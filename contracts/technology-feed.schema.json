{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsi.local/contracts/technology-feed.schema.json",
  "title": "TechnologyFeedItem",
  "type": "object",
  "required": [
    "id",
    "type",
    "category",
    "title",
    "summary",
    "why_it_matters",
    "priority",
    "confidence",
    "sources_count",
    "first_seen",
    "published_at",
    "expires_at",
    "impact"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "technology"
    },
    "category": {
      "type": "string",
      "enum": [
        "ai",
        "development",
        "cloud",
        "security",
        "dev-tooling",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "impact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "status",
            "repositories"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "potential",
                "not_affected",
                "unknown"
              ]
            },
            "repositories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
